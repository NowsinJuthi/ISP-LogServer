NODE_ENV=production

POSTGRES_USER=logserver
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=logserver

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

DATABASE_URL=postgresql://logserver:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/logserver
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRES_IN=7d

COOKIE_SECURE=false
WEB_ORIGIN=http://YOUR_SERVER_IP

PORT=4000
SYSLOG_UDP_PORT=514

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_ADMIN_EMAIL=
ALLOW_DESTRUCTIVE_SEED=false

NGINX_CONF=logserver.conf

SMS_URL_ALLOWLIST=
SMS_DAILY_LIMIT=30
SMTP_HOST_ALLOWLIST=
SMTP_ALLOW_PRIVATE=false
SMTP_PORT_ALLOWLIST=
